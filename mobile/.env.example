# Copy this file to .env and fill in your own Supabase project's values.
# Get these from: Supabase dashboard > Project Settings > API
#
# EXPO_PUBLIC_SUPABASE_ANON_KEY is the "anon / public" key — it is designed
# to be shipped inside client apps and is safe to put here. Never put the
# "service_role" key in this file or anywhere in the app — that key bypasses
# all security rules and must only ever live on a trusted server.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
